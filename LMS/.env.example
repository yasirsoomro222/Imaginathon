# Copy this file to .env and fill in your values.
# Without SMTP settings the app still works — emails are printed to the console as [SIMULATED EMAIL].

SECRET_KEY=change-me-to-a-random-string

# --- Email (optional) ---
# Example for Gmail: create an App Password (Google Account > Security > 2-Step Verification > App passwords)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_DEFAULT_SENDER=your_email@gmail.com
